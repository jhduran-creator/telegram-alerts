{
  "name": "@kmessage/telegram-alerts",
  "version": "1.1.0",
  "description": "Alertas por Telegram para los sistemas de Kuanta Bridge: CRITICAL inmediato, WARNING en digest, rate limiting y formato uniforme.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs",
    "test": "node tests/dualFormat.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhduran-creator/telegram-alerts.git"
  }
}
